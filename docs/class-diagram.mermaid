classDiagram
    class AppState {
        +playlist: Playlist
        +player: PlayerStatus
        +equalizer: Equalizer
        +lyrics: Option~Lrc~
        +lyric_offset_ms: i64
        +spectrum: SpectrumData
        +skin: Skin
        +settings: Settings
        +mini_window_id: Option~WindowId~
        +mini_lyrics_id: Option~WindowId~
        +engine: Arc~PlaybackEngineHandle~
        +new() (Self, Task)
        +update(msg) Task
        +view(id) Element
        +subscription() Subscription
    }

    class Track {
        +id: String
        +path: PathBuf
        +title: String
        +artist: String
        +album: Option~String~
        +duration: Duration
        +cover: Option~Vec~u8~~
    }

    class Playlist {
        +tracks: Vec~Track~
        +queue: VecDeque~usize~
        +current_index: Option~usize~
        +loop_mode: LoopMode
        +add(path)
        +remove(i)
        +move_item(from,to)
        +clear()
        +next() Option~usize~
        +prev() Option~usize~
    }

    class LoopMode {
        <<enum>>
        Single
        List
        Random
        Sequential
    }

    class PlayerStatus {
        +state: PlaybackState
        +position: Duration
        +duration: Duration
        +volume: f32
        +muted: bool
    }

    class PlaybackState {
        <<enum>>
        Stopped
        Playing
        Paused
    }

    class Equalizer {
        +bands: f32[10]
        +band_freqs: f32[10]
        +master_gain_db: f32
        +enabled: bool
        +preset: EqPreset
        +to_biquad_coeffs(fs) Vec~BiquadCoeff~
        +apply_preset(name)
    }

    class EqPreset {
        <<enum>>
        Flat
        Pop
        Rock
        Classical
        Vocal
        Custom
    }

    class BiquadCoeff {
        +b0: f32
        +b1: f32
        +b2: f32
        +a1: f32
        +a2: f32
        +peaking(f0,fs,gain_db,q) Self
    }

    class DspChain {
        +filters: Vec~Biquad~
        +master_gain: f32
        +from_equalizer(eq,fs) Self
        +process(frame) Vec~f32~
    }

    class Biquad {
        +coeff: BiquadCoeff
        +x1: f32
        +x2: f32
        +y1: f32
        +y2: f32
        +process(x) f32
    }

    class Lrc {
        +lines: Vec~LrcLine~
        +title: Option~String~
        +artist: Option~String~
        +parse(bytes) Result~Lrc~
        +current_line(pos) usize
    }

    class LrcLine {
        +time: Duration
        +text: String
    }

    class SpectrumData {
        +bands: Vec~f32~
        +band_count: usize
        +led_segments: usize
        +to_led_levels() Vec~u8~
    }

    class Skin {
        +id: String
        +name: String
        +colors: SkinColors
        +layout: SkinLayout
        +from_json(path) Result~Skin~
        +builtin() Vec~Skin~
    }

    class SkinColors {
        +bg: String
        +fg: String
        +accent: String
        +spectrum_low: String
        +spectrum_high: String
    }

    class SkinLayout {
        +show_spectrum: bool
        +mini_size: (u32,u32)
        +density: f32
    }

    class Settings {
        +skin_id: String
        +close_to_tray: bool
        +mini_mode: bool
        +eq_preset: String
        +bands: f32[10]
        +master_gain_db: f32
        +volume: f32
        +lyric_offset_ms: i64
        +load() Settings
        +save() Result
    }

    class AudioEvent {
        <<enum>>
        Position(Duration, Duration)
        Spectrum(SpectrumData)
        Ended
        Error(String)
    }

    class EngineCommand {
        <<enum>>
        Play(Track)
        Pause
        Resume
        Seek(Duration)
        SetEqualizer(Equalizer)
        SetVolume(f32)
        SetMuted(bool)
    }

    class AppMessage {
        <<enum>>
        TogglePlay
        Play
        Pause
        Next
        Prev
        Seek(Duration)
        SetVolume(f32)
        ToggleMute
        SetLoopMode(LoopMode)
        AddFiles
        RemoveTrack(usize)
        PlayTrack(usize)
        MoveTrack(usize,usize)
        ClearPlaylist
        AudioEvent(AudioEvent)
        LoadLyrics(PathBuf)
        SetLyricOffset(i64)
        ToggleMiniLyrics
        SetEqualizerBands(f32[10])
        ApplyEqPreset(EqPreset)
        SetMasterGain(f32)
        SetSkin(String)
        EnterMiniMode
        ExitMiniMode
        TrayAction(TrayAction)
        WindowClose(WindowId)
    }

    class TrayAction {
        <<enum>>
        PlayPause
        Next
        Prev
        ShowMainWindow
        MiniMode
        Quit
    }

    class PlaybackEngine {
        +stream: cpal~Stream~
        +decoder: SymphoniaDecoder
        +resampler: RubatoResampler
        +dsp: DspChain
        +tx: Sender~AudioEvent~
        +rx_cmd: Receiver~EngineCommand~
        +play(track)
        +pause()
        +resume()
        +seek(d)
        +set_equalizer(eq)
        +set_volume(f32)
        +callback(data, info)
    }

    AppState --> Playlist
    AppState --> PlayerStatus
    AppState --> Equalizer
    AppState --> Lrc
    AppState --> SpectrumData
    AppState --> Skin
    AppState --> Settings
    Playlist --> Track
    Playlist --> LoopMode
    PlayerStatus --> PlaybackState
    Equalizer --> EqPreset
    Equalizer ..> BiquadCoeff : to_biquad_coeffs
    DspChain *-- Biquad
    Biquad --> BiquadCoeff
    Equalizer ..> DspChain : builds
    Lrc *-- LrcLine
    Skin *-- SkinColors
    Skin *-- SkinLayout
    AppMessage ..> AudioEvent
    AppMessage ..> TrayAction
    AppMessage ..> LoopMode
    AppMessage ..> EqPreset
    PlaybackEngine ..> AudioEvent : emits
    PlaybackEngine ..> EngineCommand : consumes
    PlaybackEngine ..> DspChain : drives
    PlaybackEngine ..> SymphoniaDecoder
    PlaybackEngine ..> RubatoResampler
